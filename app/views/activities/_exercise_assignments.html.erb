<section>
  <% if current_teacher %>
    <section class="activity-assignment-panel" aria-labelledby="activity-assignment-title">
      <h2 id="activity-assignment-title">Adicionar exercício à aula</h2>
      <%= form_with model: activity_exercise, url: activity_exercises_path, html: { class: "activity-assignment-form" } do |form| %>
        <%= form.hidden_field :activity_id, value: activity.id %>
        <div class="activity-assignment-field">
          <%= form.label :exercise_id, "Exercício" %>
          <%= form.collection_select :exercise_id, available_exercises, :id, :title, { include_blank: true }, { required: true } %>
        </div>
        <div class="activity-assignment-field activity-assignment-points">
          <%= form.label :points, "Pontos" %>
          <%= form.number_field :points, min: 0, max: ActivityExercise::MAX_POINTS, step: 1, required: true %>
        </div>
        <div class="activity-assignment-actions">
          <%= form.submit "Adicionar exercício", class: "button activity-assignment-submit" %>
          <%= link_to "Criar exercício", new_exercise_path(activity_id: activity.id), class: "button activity-assignment-create" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="activity-exercise-list-panel" aria-labelledby="activity-exercise-list-title">
    <h2 id="activity-exercise-list-title">Exercícios na aula</h2>
    <% if activity_exercises.empty? %>
      <% if current_teacher %>
        <p class="empty-lesson-notice activity-exercise-empty-state">Esta aula não possui exercícios ativos. Adicione ou ative exercícios para que os alunos possam concluí-la.</p>
      <% else %>
        <p class="empty-lesson-notice activity-exercise-empty-state">Esta aula ainda não possui exercícios disponíveis.</p>
      <% end %>
    <% end %>
    <% if current_teacher %>
      <table class="exercise-table activity-exercise-list-table activity-exercise-list-table--teacher" data-controller="sortable-exercises" data-sortable-exercises-url-value="<%= reorder_activity_exercises_path(activity) %>">
    <% else %>
      <table class="exercise-table activity-exercise-list-table activity-exercise-list-table--student">
    <% end %>
      <thead><tr><th>Posição</th><th>Exercício</th><th>Pontos</th><% if current_teacher %><th>Ações</th><% end %></tr></thead>
      <% if current_teacher %>
        <tbody data-sortable-exercises-target="list">
      <% else %>
        <tbody>
      <% end %>
      <% activity_exercises.each do |activity_exercise| %>
        <% if current_teacher %>
          <tr draggable="true" data-id="<%= activity_exercise.id %>">
        <% else %>
          <tr>
        <% end %>
          <td class="activity-exercise-position"><% if current_teacher %><i class="fa-solid fa-grip-vertical" aria-hidden="true" title="Arrastar para reordenar"></i><% end %> <span data-position><%= activity_exercise.position %></span></td>
          <td class="activity-exercise-title"><%= link_to activity_exercise.exercise.title, exercise_path(activity_exercise.exercise, **{ activity_exercise_id: activity_exercise.id, activity_id: (activity.id if current_teacher) }.compact) %></td>
          <td class="activity-exercise-points"><%= activity_exercise.points %></td>
          <% if current_teacher %>
            <td class="activity-exercise-actions">
              <%= button_to activity_exercise_path(activity_exercise), method: :delete, class: "button activity-exercise-remove", title: "Remover exercício", aria: { label: "Remover exercício" }, form: { data: { turbo_confirm: "Remover este exercício da aula? O exercício continuará disponível na sua lista." } } do %>
                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
      </tbody>
    </table>
  </section>
</section>
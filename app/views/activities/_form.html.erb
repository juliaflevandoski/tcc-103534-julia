<%= render "shared/errors", record: activity %><%= form_with model: activity do |form| %><%= form.label :class_id, "Turma" %><%= form.collection_select :class_id, school_classes, :id, :name, include_blank: true %><%= form.label :title, "Título" %><%= form.text_field :title %><%= form.label :published, "Publicada" %><%= form.check_box :published %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", activities_path, class: "button" %></div><% end %>
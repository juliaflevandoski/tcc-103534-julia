<main class="activities-index">
	<header class="activities-index-header">
		<h1>Aulas</h1>
		<% if current_teacher %><%= link_to "Nova aula", new_activity_path, class: "button activities-index-new-button" %><% end %>
	</header>
	<ul class="activities-index-grid" aria-label="Aulas">
		<% @activities.each do |activity| %>
			<li>
				<article class="activities-index-card">
					<div class="activities-index-card-details">
						<h2><%= activity.title %></h2>
						<p class="activities-index-class">Turma: <%= activity.school_class.name %></p>
						<p class="activities-index-status <%= activity.published? ? "is-published" : "is-draft" %>">
							<span class="activities-index-status-indicator" aria-hidden="true"></span>
							<%= activity.published? ? "Publicada" : "Rascunho" %>
						</p>
					</div>
					<% if current_teacher %>
						<div class="activities-index-actions">
							<%= link_to "Ver", activity, class: "button activities-index-view-button" %>
							<%= link_to "Editar", edit_activity_path(activity), class: "button activities-index-edit-button" %>
							<%= button_to "Desativar", activity, method: :delete, class: "button activities-index-danger-button", form: { data: { turbo_confirm: "Desativar esta aula? Ela deixará de aparecer para os alunos." } } %>
						</div>
					<% end %>
				</article>
			</li>
		<% end %>
	</ul>
</main>
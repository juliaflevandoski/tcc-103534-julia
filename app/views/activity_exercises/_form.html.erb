<%= render "shared/errors", record: activity_exercise %><%= form_with model: activity_exercise do |form| %><%= form.label :activity_id, "Aula" %><%= form.collection_select :activity_id, activities, :id, :title, include_blank: true %><%= form.label :exercise_id, "Exercício" %><%= form.collection_select :exercise_id, exercises, :id, :title, include_blank: true %><%= form.label :position, "Posição" %><%= form.number_field :position, min: 0 %><%= form.label :points, "Pontos" %><%= form.number_field :points, min: 0 %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", activity_exercises_path, class: "button" %></div><% end %>
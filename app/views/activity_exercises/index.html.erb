<main><div class="toolbar"><h1>Exercícios nas aulas</h1><%= link_to "Adicionar exercício", new_activity_exercise_path, class: "button" %></div><table><thead><tr><th>Aula</th><th>Exercício</th><th>Posição</th><th>Pontos</th><th></th></tr></thead><tbody><% @activity_exercises.each do |item| %><tr><td><%= item.activity.title %></td><td><%= item.exercise.title %></td><td><%= item.position %></td><td><%= item.points %></td><td><%= link_to "Ver", item %> | <%= link_to "Editar", edit_activity_exercise_path(item) %> | <%= button_to "Desativar", item, method: :delete, class: "button danger" %></td></tr><% end %></tbody></table></main>
<main>
	<h1>Editar comentário</h1>
	<%= render "shared/errors", record: @comment %>
	<%= form_with model: @comment, url: school_class_class_post_comment_path(@school_class, @class_post, @comment) do |form| %>
		<%= form.label :body, "Comentário" %>
		<%= form.text_area :body, required: true, maxlength: ClassPostComment::MAX_BODY_LENGTH, rows: 3 %>
		<div class="actions">
			<%= form.submit "Salvar" %>
			<%= link_to "Cancelar", school_class_class_posts_path(@school_class), class: "button" %>
		</div>
	<% end %>
</main>

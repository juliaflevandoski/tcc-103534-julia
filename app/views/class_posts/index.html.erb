<main class="class-wall-page">
	<header class="class-wall-header">
		<div class="class-wall-heading">
			<span class="class-wall-badge">Mural</span>
			<h1><%= @school_class.name %></h1>
			<p class="class-wall-subtitle">Publicações e comentários da turma</p>
		</div>
		<%= link_to "Voltar à turma", school_class_path(@school_class), class: "button class-wall-back" %>
	</header>

	<% if policy(@new_post).create? %>
		<section class="class-wall-new-post">
			<h2>Nova publicação</h2>
			<%= render "shared/errors", record: @new_post %>
			<%= form_with model: @new_post, url: school_class_class_posts_path(@school_class), class: "class-wall-form" do |form| %>
				<div class="class-wall-field">
					<%= form.label :body, "Texto" %>
					<%= form.text_area :body, required: true, maxlength: ClassPost::MAX_BODY_LENGTH, rows: 4, placeholder: "Escreva um aviso para a turma" %>
				</div>
				<div class="actions class-wall-actions"><%= form.submit "Publicar", class: "class-wall-submit" %></div>
			<% end %>
		</section>
	<% end %>

	<% if @posts.empty? %>
		<div class="class-wall-empty"><p>Nenhuma publicação no mural ainda.</p></div>
	<% end %>

	<% @posts.each do |post| %>
		<% post_comments = @comments_by_post.fetch(post.id, []) %>
		<article id="class_post_<%= post.id %>" class="class-wall-post">
			<header class="class-wall-post-header">
				<div class="class-wall-author">
					<span class="class-wall-avatar" aria-hidden="true"><%= post.teacher.name.to_s.strip[0].to_s.upcase %></span>
					<div class="class-wall-author-info">
						<h3><%= post.teacher.name %></h3>
						<small><%= l(post.created_at, format: :short) %></small>
					</div>
				</div>
				<% if policy(post).update? %>
					<div class="class-wall-item-actions">
						<%= link_to "Editar", edit_school_class_class_post_path(@school_class, post), class: "button class-wall-action class-wall-action-edit" %>
						<%= button_to "Excluir", school_class_class_post_path(@school_class, post), method: :delete, class: "button class-wall-action class-wall-action-danger", form_class: "class-wall-inline-form", form: { data: { turbo_confirm: "Excluir esta publicação?" } } %>
					</div>
				<% end %>
			</header>
			<p class="class-wall-body"><%= post.body %></p>

			<section class="class-wall-comments">
				<h4>Comentários</h4>
				<% if post_comments.empty? %>
					<p class="class-wall-comments-empty">Ainda não há comentários.</p>
				<% end %>
				<% post_comments.each do |comment| %>
					<div id="class_post_comment_<%= comment.id %>" class="class-wall-comment">
						<div class="class-wall-comment-header">
							<p class="class-wall-comment-meta"><strong><%= comment.author.name %></strong> <small><%= l(comment.created_at, format: :short) %></small></p>
							<% comment_policy = policy(comment) %>
							<% if comment_policy.update? || comment_policy.destroy? %>
								<div class="class-wall-item-actions">
									<% if comment_policy.update? %>
										<%= link_to "Editar", edit_school_class_class_post_comment_path(@school_class, post, comment), class: "button class-wall-action class-wall-action-edit" %>
									<% end %>
									<% if comment_policy.destroy? %>
										<%= button_to "Excluir", school_class_class_post_comment_path(@school_class, post, comment), method: :delete, class: "button class-wall-action class-wall-action-danger", form_class: "class-wall-inline-form", form: { data: { turbo_confirm: "Excluir este comentário?" } } %>
									<% end %>
								</div>
							<% end %>
						</div>
						<p class="class-wall-body"><%= comment.body %></p>
					</div>
				<% end %>

				<% new_comment = @invalid_comment if @invalid_comment&.class_post_id == post.id %>
				<% new_comment ||= post.comments.build %>
				<% if policy(new_comment).create? %>
					<div class="class-wall-comment-form">
						<%= render "shared/errors", record: new_comment %>
						<%= form_with model: new_comment, url: school_class_class_post_comments_path(@school_class, post), class: "class-wall-form" do |form| %>
							<div class="class-wall-field">
								<%= form.label :body, "Comentar", for: "comment_body_#{post.id}" %>
								<%= form.text_area :body, required: true, maxlength: ClassPostComment::MAX_BODY_LENGTH, rows: 2, id: "comment_body_#{post.id}" %>
							</div>
							<div class="actions class-wall-actions"><%= form.submit "Comentar", class: "class-wall-submit" %></div>
						<% end %>
					</div>
				<% end %>
			</section>
		</article>
	<% end %>
</main>

<%= render "shared/errors", record: class_student %><%= form_with model: class_student do |form| %><%= form.label :student_id, "Aluno" %><%= form.collection_select :student_id, students, :id, :name, include_blank: true %><%= form.label :class_id, "Turma" %><%= form.collection_select :class_id, school_classes, :id, :name, include_blank: true %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", class_students_path, class: "button" %></div><% end %>
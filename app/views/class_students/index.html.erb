<main><div class="toolbar"><h1>Matrículas</h1><%= link_to "Nova matrícula", new_class_student_path, class: "button" %></div><table><thead><tr><th>Aluno</th><th>Turma</th><th></th></tr></thead><tbody><% @class_students.each do |membership| %><tr><td><%= membership.student.name %></td><td><%= membership.school_class.name %></td><td><%= link_to "Ver", membership %> | <%= link_to "Editar", edit_class_student_path(membership) %> | <%= button_to "Desativar", membership, method: :delete, class: "button danger" %></td></tr><% end %></tbody></table></main>
<% if attempts.empty? %>
	<span>Nenhuma tentativa registrada.</span>
<% else %>
	<details class="attempt-history">
		<summary>Histórico (<%= attempts.length %>)</summary>
		<ol>
			<% attempts.each do |attempt| %>
				<% is_official = official_attempt&.id == attempt.id %>
				<% possible_points = ActivityResults.points_possible(attempt:) %>
				<li class="attempt-history-item<%= " is-official" if is_official %><%= " is-inactive" unless attempt.active? %>">
					<span class="attempt-history-main">
						<time datetime="<%= attempt.created_at.iso8601 %>"><%= l(attempt.created_at, format: :short) %></time>:
						<span class="attempt-history-score">
							<%= attempt.score %> / <%= possible_points.nil? ? "máximo não registrado" : "#{possible_points} pontos" %>
							<% percentage = ActivityResults.attempt_percentage(attempt:) %>
							<%= "(#{number_to_percentage(percentage, precision: 1)})" if percentage %>
							<%= "Percentual indisponível: máximo histórico não registrado" if possible_points.nil? %>
						</span>
					</span>
					<span class="attempt-history-tags">
						<%= content_tag(:span, "Nota oficial", class: "attempt-history-tag attempt-history-tag--official") if is_official %>
						<%= content_tag(:span, "Tentativa não oficial", class: "attempt-history-tag") unless is_official %>
						<%= content_tag(:span, "Desativada", class: "attempt-history-tag attempt-history-tag--inactive") unless attempt.active? %>
					</span>
					<span class="attempt-history-actions">
						<%= link_to "Detalhes", exercise_attempt_path(attempt) %>
					</span>
				</li>
			<% end %>
		</ol>
	</details>
<% end %>
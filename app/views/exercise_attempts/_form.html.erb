<%= render "shared/errors", record: exercise_attempt %><%= form_with model: exercise_attempt do |form| %><%= form.label :student_id, "Aluno" %><%= form.collection_select :student_id, students, :id, :name, include_blank: true %><%= form.label :activity_exercise_id, "Exercício da aula" %><%= form.collection_select :activity_exercise_id, activity_exercises, :id, ->(item) { "#{item.activity.title} - #{item.exercise.title}" }, include_blank: true %><%= form.label :answer, "Resposta JSON" %><%= form.text_area :answer, value: exercise_attempt.answer.to_json, rows: 5 %><%= form.label :correct, "Gabarito JSON" %><%= form.text_area :correct, value: exercise_attempt.correct.to_json, rows: 5 %><%= form.label :score, "Pontuação" %><%= form.number_field :score, min: 0 %><%= form.label :time_spent, "Tempo (segundos)" %><%= form.number_field :time_spent, min: 0 %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", exercise_attempts_path, class: "button" %></div><% end %>
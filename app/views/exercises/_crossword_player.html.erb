<% prefilled_cells = local_assigns[:cells] || {} %>
<h1><%= exercise.title %></h1>
<p><%= crossword.fetch(:instructions) %></p>
<p><%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %></p>
<%= form_with url: exercise_attempts_path, scope: :exercise_attempt, data: { controller: "crossword-player", action: "input->crossword-player#updatePendingStatus submit->crossword-player#serializeAnswer" } do %>
  <%= hidden_field_tag "exercise_attempt[activity_exercise_id]", activity_exercise.id %>
  <%= hidden_field_tag "exercise_attempt[answer]", "{}", data: { crossword_player_target: "answer" } %>
  <div class="crossword-board-scroll">
    <table class="crossword-grid crossword-answer-grid" aria-label="Grade de palavras cruzadas">
      <% crossword.fetch(:grid_mask).each_with_index do |row, row_index| %>
        <tr>
          <% row.each_with_index do |open_cell, column_index| %>
            <% if open_cell %>
              <% starting_numbers = crossword.fetch(:entries).select { |entry| entry[:row] == row_index && entry[:column] == column_index }.map { |entry| entry[:number] }.uniq %>
              <td class="crossword-letter-cell">
                <% if starting_numbers.any? %><span class="crossword-cell-number"><%= starting_numbers.min %></span><% end %>
                <input type="text" maxlength="1" autocomplete="off" autocapitalize="characters" spellcheck="false"
                  aria-label="Linha <%= row_index + 1 %>, coluna <%= column_index + 1 %>"
                  required value="<%= prefilled_cells["#{row_index}-#{column_index}"] %>"                  data-crossword-player-target="cell" data-row="<%= row_index %>" data-column="<%= column_index %>"
                  data-action="input->crossword-player#inputLetter keydown->crossword-player#navigateCells">
              </td>
            <% else %>
              <td class="crossword-blocked-cell" aria-hidden="true"></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </table>
  </div>

  <% [["across", "Horizontal"], ["down", "Vertical"]].each do |direction, label| %>
    <% entries = crossword.fetch(:entries).select { |entry| entry[:direction] == direction }.sort_by { |entry| entry[:number] } %>
    <% next if entries.empty? %>
    <h2><%= label %></h2>
    <ol>
      <% entries.each do |entry| %>
        <li value="<%= entry[:number] %>" data-crossword-player-target="entry"
          data-row="<%= entry[:row] %>" data-column="<%= entry[:column] %>"
          data-direction="<%= entry[:direction] %>" data-length="<%= entry[:length] %>"
          data-pending-label="palavra <%= entry[:number] %> (<%= label.downcase %>)"><%= entry[:clue] %> (<%= entry[:length] %> letras)</li>
      <% end %>
    </ol>
  <% end %>

  <p data-crossword-player-target="status" role="status" aria-live="polite"></p>
  <div class="actions"><%= submit_tag "Conferir cruzadinha", class: "button", data: { turbo_submits_with: "Enviando..." } %></div>
<% end %>
<%= render "shared/errors", record: exercise %>
<% memory_image_urls = exercise.memory_images_attachments.to_h { |attachment| [attachment.blob_id.to_s, rails_blob_path(attachment.blob, only_path: true)] } %>
<%= form_with model: exercise, multipart: true, data: { controller: "exercise-form unsaved-changes", action: "submit->exercise-form#prepareObject turbo:submit-start->unsaved-changes#submitStart turbo:submit-end->unsaved-changes#submitEnd", unsaved_changes_start_dirty_value: exercise.errors.any?, exercise_form_crossword_preview_url_value: crossword_preview_exercises_path, exercise_form_quiz_generate_url_value: generate_quiz_exercises_path, exercise_form_fill_blanks_generate_url_value: generate_fill_blanks_exercises_path, exercise_form_ordering_generate_url_value: generate_ordering_exercises_path, exercise_form_crossword_generate_url_value: generate_crossword_exercises_path, exercise_form_memory_game_generate_url_value: generate_memory_game_exercises_path, exercise_form_memory_game_image_urls_value: memory_image_urls.to_json } do |form| %>
	<%= hidden_field_tag :activity_id, @source_activity.id if @source_activity %>
	<%= form.label :title, "Título" %>
	<%= form.text_field :title, required: true, maxlength: 150, data: { exercise_form_target: "title" } %>

	<%= form.label :description, "Descrição" %>
	<%= form.text_area :description, maxlength: 255 %>

	<%= form.label :exercise_type, "Tipo" %>
	<%= form.select :exercise_type,
		[["Quiz", "quiz"], ["Complete as lacunas", "fill_blanks"], ["Ordenação", "ordering"], ["Palavra cruzada", "crossword"], ["Jogo da memória", "memory_game"]],
		{ include_blank: "Selecione um tipo" },
		required: true,
		data: { exercise_form_target: "typeSelect", action: "change->exercise-form#changeType" } %>

	<%= form.hidden_field :object, value: exercise.object.to_json, data: { exercise_form_target: "objectInput" } %>

	<section data-exercise-form-target="quizFields" hidden>
		<h2>Editor do quiz</h2>
		<button type="button" class="button quiz-ai-open" data-action="exercise-form#openQuizAiModal">Gerar com IA <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i></button>
		<dialog class="quiz-ai-modal" data-exercise-form-target="quizAiModal" data-ai-generation-kind="quiz" data-action="close->exercise-form#invalidateAiGeneration" aria-labelledby="quiz-ai-title">
			<h2 id="quiz-ai-title">Gerar quiz com IA</h2>
			<p>O quiz gerado será apenas uma sugestão para revisão. Ele não será salvo automaticamente.</p>
			<label for="quiz_ai_topic">Tema do quiz</label>
			<%= text_field_tag :quiz_ai_topic, nil, data: { exercise_form_target: "quizAiTopic" } %>

			<label for="quiz_ai_difficulty">Dificuldade</label>
			<%= select_tag :quiz_ai_difficulty,
				options_for_select([["Fácil", "easy"], ["Médio", "medium"], ["Difícil", "hard"]]),
				{ prompt: "Selecione a dificuldade", data: { exercise_form_target: "quizAiDifficulty" } } %>

			<label for="quiz_ai_question_count">Quantidade de questões</label>
			<%= number_field_tag :quiz_ai_question_count, 5, min: 1, max: 20, data: { exercise_form_target: "quizAiQuestionCount" } %>

			<fieldset class="quiz-ai-types">
				<legend>Tipos de questão</legend>
				<label><input type="checkbox" value="multiple_choice" data-exercise-form-target="quizAiQuestionType"> Múltipla escolha</label>
				<label><input type="checkbox" value="true_false" data-exercise-form-target="quizAiQuestionType"> Verdadeiro ou falso</label>
				<label><input type="checkbox" value="short_answer" data-exercise-form-target="quizAiQuestionType"> Resposta curta</label>
			</fieldset>
			<p class="errors" data-exercise-form-target="quizAiTypeError" role="alert" hidden></p>
			<label for="quiz_ai_refinement">Instruções adicionais (opcional)</label>
			<%= text_field_tag :quiz_ai_refinement, nil, maxlength: 300, data: { exercise_form_target: "quizAiRefinement" } %>
			<button type="button" class="button" data-exercise-form-target="quizAiGenerateButton" data-action="exercise-form#generateQuiz">Gerar sugestão</button>
			<button type="button" class="button" data-exercise-form-target="quizAiRefineButton" data-action="exercise-form#refineAiSuggestion" data-exercise-form-kind-param="quiz" hidden>Refinar sugestão</button>
			<p data-exercise-form-target="quizAiStatus" role="status" aria-live="polite"></p>
			<section class="quiz-ai-preview" data-exercise-form-target="quizAiPreview" aria-live="polite" hidden>
				<h3>Prévia do quiz</h3>
				<ol data-exercise-form-target="quizAiPreviewQuestions"></ol>
				<button type="button" class="button" data-exercise-form-target="quizAiApplyButton" data-action="exercise-form#applyGeneratedQuiz" hidden>Aplicar ao editor</button>
			</section>
			<div class="actions"><button type="button" class="button" data-action="exercise-form#closeAiModal">Cancelar</button></div>
		</dialog>
		<div data-exercise-form-target="questionsList"></div>
		<template data-exercise-form-target="questionTemplate">
			<fieldset class="quiz-question" data-question>
				<legend data-question-title></legend>
				<button type="button" class="button danger" data-action="exercise-form#removeQuestion">Remover pergunta</button>

				<label>Tipo da pergunta
					<select data-question-type data-action="change->exercise-form#changeQuestionType">
						<option value="multiple_choice">Múltipla escolha</option>
						<option value="true_false">Verdadeiro ou falso</option>
						<option value="short_answer">Resposta curta</option>
					</select>
				</label>

				<label>Enunciado<textarea data-question-statement></textarea></label>

				<fieldset data-question-options-panel hidden disabled>
					<legend>Alternativas</legend>
					<div data-question-options-list></div>
					<template data-question-option-template>
						<div class="quiz-option" data-option-row>
							<label>Alternativa<input type="text" data-option-text></label>
							<label class="quiz-correct-option"><input type="radio" data-option-correct> Correta</label>
							<button type="button" class="button danger" data-action="exercise-form#removeOption">Remover alternativa</button>
						</div>
					</template>
					<button type="button" class="button" data-action="exercise-form#addOption">Adicionar alternativa</button>
				</fieldset>

				<fieldset data-question-true-false-panel hidden disabled>
					<legend>Resposta correta</legend>
					<label><input type="radio" value="true" data-question-true-false-correct> Verdadeiro</label>
					<label><input type="radio" value="false" data-question-true-false-correct> Falso</label>
				</fieldset>

				<fieldset data-question-short-answer-panel hidden disabled>
					<legend>Resposta esperada</legend>
					<input type="text" data-question-short-answer-correct>
				</fieldset>
			</fieldset>
		</template>
		<button type="button" class="button" data-action="exercise-form#addQuestion">Adicionar pergunta</button>
		<p class="errors" data-exercise-form-target="error" role="alert" hidden></p>
	</section>

	<section data-exercise-form-target="fillBlanksFields" hidden>
		<button type="button" class="button" data-action="exercise-form#openFillBlanksAiModal">Gerar lacunas com IA</button>
		<dialog class="quiz-ai-modal" data-exercise-form-target="fillBlanksAiModal" data-ai-generation-kind="fillBlanks" data-action="close->exercise-form#invalidateAiGeneration" aria-labelledby="fill-blanks-ai-title">
			<h2 id="fill-blanks-ai-title">Gerar exercício de lacunas com IA</h2>
			<p>A sugestão será aplicada somente ao editor após revisão. Não será salva automaticamente.</p>
			<label for="fill_blanks_ai_topic">Tema do exercício</label>
			<%= text_field_tag :fill_blanks_ai_topic, nil, data: { exercise_form_target: "fillBlanksAiTopic" } %>
			<label for="fill_blanks_ai_difficulty">Dificuldade</label>
			<%= select_tag :fill_blanks_ai_difficulty,
				options_for_select([["Fácil", "easy"], ["Médio", "medium"], ["Difícil", "hard"]]),
				{ prompt: "Selecione a dificuldade", data: { exercise_form_target: "fillBlanksAiDifficulty" } } %>
			<label for="fill_blanks_ai_count">Quantidade de lacunas</label>
			<%= number_field_tag :fill_blanks_ai_count, 3, min: 1, max: 20, data: { exercise_form_target: "fillBlanksAiCount" } %>
			<label for="fill_blanks_ai_refinement">Instruções adicionais (opcional)</label>
			<%= text_field_tag :fill_blanks_ai_refinement, nil, maxlength: 300, data: { exercise_form_target: "fillBlanksAiRefinement" } %>
			<button type="button" class="button" data-exercise-form-target="fillBlanksAiGenerateButton" data-action="exercise-form#generateFillBlanks">Gerar sugestão</button>
			<button type="button" class="button" data-exercise-form-target="fillBlanksAiRefineButton" data-action="exercise-form#refineAiSuggestion" data-exercise-form-kind-param="fillBlanks" hidden>Refinar sugestão</button>
			<p data-exercise-form-target="fillBlanksAiStatus" role="status" aria-live="polite"></p>
			<section class="quiz-ai-preview" data-exercise-form-target="fillBlanksAiPreview" hidden aria-live="polite">
				<h3>Prévia</h3>
				<p data-exercise-form-target="fillBlanksAiText"></p>
				<ol data-exercise-form-target="fillBlanksAiAnswers"></ol>
				<button type="button" class="button" data-exercise-form-target="fillBlanksAiApplyButton" data-action="exercise-form#applyGeneratedFillBlanks" hidden>Aplicar ao editor</button>
			</section>
			<div class="actions"><button type="button" class="button" data-action="exercise-form#closeAiModal">Cancelar</button></div>
		</dialog>
		<%= label_tag :fill_text_template, "Texto do exercício" %>
		<%= text_area_tag :fill_text_template, nil,
			data: { exercise_form_target: "fillTextTemplate", action: "input->exercise-form#refreshBlanks" } %>
		<button type="button" class="button" data-action="exercise-form#convertSelection">Converter seleção em lacuna</button>
		<div data-exercise-form-target="blanksList"></div>
		<template data-exercise-form-target="blankTemplate">
			<label data-blank-row>Resposta para lacuna <span data-blank-number></span>
				<input type="text" data-blank-answer>
			</label>
		</template>
		<p class="errors" data-exercise-form-target="blankError" role="alert" hidden></p>
	</section>

	<section data-exercise-form-target="orderingFields" hidden>
		<%= label_tag :ordering_format, "Formato da ordenação" %>
		<%= select_tag :ordering_format,
			options_for_select([["Sequência única", "single_sequence"], ["Múltiplas frases", "multiple_sentences"]]),
			data: { exercise_form_target: "orderingFormat", action: "change->exercise-form#changeOrderingFormat" } %>
		<div data-exercise-form-target="orderingAiOpenWrapper">
			<button type="button" class="button" data-action="exercise-form#openOrderingAiModal">Gerar ordenação com IA</button>
		</div>
		<dialog class="quiz-ai-modal" data-exercise-form-target="orderingAiModal" data-ai-generation-kind="ordering" data-action="close->exercise-form#invalidateAiGeneration" aria-labelledby="ordering-ai-title">
			<h2 id="ordering-ai-title">Gerar exercício de Ordenação com IA</h2>
			<p>A sugestão será aplicada somente ao editor após revisão. Não será salva automaticamente.</p>
			<label for="ordering_ai_topic">Tema do exercício</label>
			<%= text_field_tag :ordering_ai_topic, nil, data: { exercise_form_target: "orderingAiTopic" } %>
			<label for="ordering_ai_difficulty">Dificuldade</label>
			<%= select_tag :ordering_ai_difficulty,
				options_for_select([["Fácil", "easy"], ["Médio", "medium"], ["Difícil", "hard"]]),
				{ prompt: "Selecione a dificuldade", data: { exercise_form_target: "orderingAiDifficulty" } } %>
			<div data-exercise-form-target="orderingAiSingleFields">
				<label for="ordering_ai_item_type">Tipo dos itens</label>
				<%= select_tag :ordering_ai_item_type,
					options_for_select([["Palavras ou elementos", "words"], ["Números inteiros", "numbers"]]),
					data: { exercise_form_target: "orderingAiItemType" } %>
				<label for="ordering_ai_item_count">Quantidade de itens</label>
				<%= number_field_tag :ordering_ai_item_count, 4, min: 2, max: 20, data: { exercise_form_target: "orderingAiItemCount" } %>
			</div>
			<div data-exercise-form-target="orderingAiMultipleFields" hidden>
				<label for="ordering_ai_sentence_count">Quantidade de frases</label>
				<%= number_field_tag :ordering_ai_sentence_count, 3, min: 2, max: 20, data: { exercise_form_target: "orderingAiSentenceCount" } %>
			</div>
			<label for="ordering_ai_refinement">Instruções adicionais (opcional)</label>
			<%= text_field_tag :ordering_ai_refinement, nil, maxlength: 300, data: { exercise_form_target: "orderingAiRefinement" } %>
			<button type="button" class="button" data-exercise-form-target="orderingAiGenerateButton" data-action="exercise-form#generateOrdering">Gerar sugestão</button>
			<button type="button" class="button" data-exercise-form-target="orderingAiRefineButton" data-action="exercise-form#refineAiSuggestion" data-exercise-form-kind-param="ordering" hidden>Refinar sugestão</button>
			<p data-exercise-form-target="orderingAiStatus" role="status" aria-live="polite"></p>
			<section class="quiz-ai-preview" data-exercise-form-target="orderingAiPreview" hidden aria-live="polite">
				<h3 data-exercise-form-target="orderingAiPreviewHeading">Prévia na sequência correta</h3>
				<p data-exercise-form-target="orderingAiInstructions"></p>
				<ol data-exercise-form-target="orderingAiItems"></ol>
				<button type="button" class="button" data-exercise-form-target="orderingAiApplyButton" data-action="exercise-form#applyGeneratedOrdering" hidden>Aplicar ao editor</button>
			</section>
			<div class="actions"><button type="button" class="button" data-action="exercise-form#closeAiModal">Cancelar</button></div>
		</dialog>
		<%= label_tag :ordering_instructions, "Pergunta ou instrução" %>
		<%= text_area_tag :ordering_instructions, nil, data: { exercise_form_target: "orderingInstructions" } %>

		<div data-exercise-form-target="orderingSingleFields">
			<%= label_tag :ordering_item_type, "Tipo dos itens" %>
			<%= select_tag :ordering_item_type,
				options_for_select([["Palavras ou elementos", "words"], ["Números inteiros", "numbers"]]),
				data: { exercise_form_target: "orderingItemType", action: "change->exercise-form#changeOrderingItemType" } %>

			<ol data-exercise-form-target="orderingItemsList" class="ordering-items-list"></ol>
			<template data-exercise-form-target="orderingItemTemplate">
				<li data-ordering-item draggable="true" data-action="dragstart->exercise-form#startOrderingItemDrag dragover->exercise-form#allowOrderingItemDrop drop->exercise-form#dropOrderingItem dragend->exercise-form#endOrderingItemDrag">
					<span class="fa-solid fa-grip-vertical ordering-item-grip" aria-hidden="true" title="Arraste para definir a ordem correta"></span>
					<label>Item <span data-ordering-item-number></span>
						<input type="text" data-ordering-item-value>
					</label>
					<button type="button" class="button danger" data-action="exercise-form#removeOrderingItem">Remover item</button>
				</li>
			</template>
			<button type="button" class="button" data-action="exercise-form#addOrderingItem">Adicionar item</button>
		</div>
		<div data-exercise-form-target="orderingMultipleFields" hidden>
			<div data-exercise-form-target="orderingSentencesList"></div>
			<template data-exercise-form-target="orderingSentenceTemplate">
				<fieldset class="ordering-sentence" data-ordering-sentence>
					<legend>Frase <span data-ordering-sentence-number></span></legend>
					<label>Frase completa<textarea rows="2" data-ordering-sentence-text></textarea></label>
					<button type="button" class="button danger" data-action="exercise-form#removeOrderingSentence">Remover frase</button>
				</fieldset>
			</template>
			<button type="button" class="button" data-action="exercise-form#addOrderingSentence">Adicionar frase</button>
		</div>
		<p class="errors" data-exercise-form-target="orderingError" role="alert" hidden></p>
	</section>

	<section data-exercise-form-target="crosswordFields" hidden>
		<button type="button" class="button" data-action="exercise-form#openCrosswordAiModal">Gerar palavras com IA</button>
		<dialog class="quiz-ai-modal" data-exercise-form-target="crosswordAiModal" data-ai-generation-kind="crossword" data-action="close->exercise-form#invalidateAiGeneration" aria-labelledby="crossword-ai-title">
			<h2 id="crossword-ai-title">Gerar palavras e pistas com IA</h2>
			<p>A sugestão será aplicada somente ao editor após revisão. A grade será construída pelo Ludus.</p>
			<label for="crossword_ai_topic">Tema da cruzadinha</label>
			<%= text_field_tag :crossword_ai_topic, nil, data: { exercise_form_target: "crosswordAiTopic" } %>
			<label for="crossword_ai_difficulty">Dificuldade</label>
			<%= select_tag :crossword_ai_difficulty,
				options_for_select([["Fácil", "easy"], ["Médio", "medium"], ["Difícil", "hard"]]),
				{ prompt: "Selecione a dificuldade", data: { exercise_form_target: "crosswordAiDifficulty" } } %>
			<label for="crossword_ai_word_count">Quantidade de palavras</label>
			<%= number_field_tag :crossword_ai_word_count, 5, min: 2, max: 20, data: { exercise_form_target: "crosswordAiWordCount" } %>
			<label for="crossword_ai_refinement">Instruções adicionais (opcional)</label>
			<%= text_field_tag :crossword_ai_refinement, nil, maxlength: 300, data: { exercise_form_target: "crosswordAiRefinement" } %>
			<button type="button" class="button" data-exercise-form-target="crosswordAiGenerateButton" data-action="exercise-form#generateCrossword">Gerar sugestão</button>
			<button type="button" class="button" data-exercise-form-target="crosswordAiRefineButton" data-action="exercise-form#refineAiSuggestion" data-exercise-form-kind-param="crossword" hidden>Refinar sugestão</button>
			<p data-exercise-form-target="crosswordAiStatus" role="status" aria-live="polite"></p>
			<section class="quiz-ai-preview" data-exercise-form-target="crosswordAiPreview" hidden aria-live="polite">
				<h3>Prévia de palavras e pistas</h3>
				<ol data-exercise-form-target="crosswordAiWords"></ol>
				<button type="button" class="button" data-exercise-form-target="crosswordAiApplyButton" data-action="exercise-form#applyGeneratedCrossword" hidden>Aplicar ao editor</button>
			</section>
			<div class="actions"><button type="button" class="button" data-action="exercise-form#closeAiModal">Cancelar</button></div>
		</dialog>
		<%= label_tag :crossword_instructions, "Instruções" %>
		<%= text_area_tag :crossword_instructions, nil,
			data: { exercise_form_target: "crosswordInstructions", action: "input->exercise-form#invalidateCrosswordPreview" } %>

		<h2>Palavras e pistas</h2>
		<div data-exercise-form-target="crosswordWordsList"></div>
		<template data-exercise-form-target="crosswordWordTemplate">
			<div class="crossword-word-row" data-crossword-word>
				<label>Palavra<input type="text" data-crossword-word-value autocomplete="off"></label>
				<label>Pista<input type="text" data-crossword-clue-value></label>
				<button type="button" class="button danger" data-action="exercise-form#removeCrosswordWord">Remover palavra</button>
			</div>
		</template>
		<button type="button" class="button" data-action="exercise-form#addCrosswordWord">Adicionar palavra</button>
		<%= hidden_field_tag :crossword_layout_seed, nil, data: { exercise_form_target: "crosswordSeed" } %>
		<div class="actions">
			<button type="button" class="button" data-action="exercise-form#previewCrossword">Gerar prévia</button>
			<button type="button" class="button" data-action="exercise-form#regenerateCrossword">Gerar outra disposição</button>
		</div>
		<p class="errors" data-exercise-form-target="crosswordError" role="alert" hidden></p>
		<section data-exercise-form-target="crosswordPreview" hidden aria-live="polite"></section>
	</section>

	<fieldset data-exercise-form-target="memoryGameFields" hidden disabled>
		<legend>Jogo da memória</legend>
		<div data-exercise-form-target="memoryEditor">
			<button type="button" class="button" data-action="exercise-form#openMemoryGameAiModal">Gerar pares com IA</button>
			<dialog class="quiz-ai-modal" data-exercise-form-target="memoryGameAiModal" data-ai-generation-kind="memoryGame" data-action="close->exercise-form#invalidateAiGeneration" aria-labelledby="memory-ai-title">
				<h2 id="memory-ai-title">Gerar pares para o jogo da memória</h2>
				<p>A IA sugere conteúdo textual. Imagens não são geradas; serão adicionadas manualmente pelo professor.</p>
				<label for="memory_ai_topic">Tema do jogo</label>
				<%= text_field_tag :memory_ai_topic, nil, data: { exercise_form_target: "memoryAiTopic" } %>
				<label for="memory_ai_difficulty">Dificuldade</label>
				<%= select_tag :memory_ai_difficulty,
					options_for_select([["Fácil", "easy"], ["Médio", "medium"], ["Difícil", "hard"]]),
					{ prompt: "Selecione a dificuldade", data: { exercise_form_target: "memoryAiDifficulty" } } %>
				<label for="memory_ai_pair_type">Tipo de associação</label>
				<%= select_tag :memory_ai_pair_type,
					options_for_select([ ["Palavra ↔ Palavra", "word_word"], ["Palavra ↔ Imagem", "word_image"], ["Imagem ↔ Imagem", "image_image"] ]),
					data: { exercise_form_target: "memoryAiPairType" } %>
				<label for="memory_ai_pair_count">Quantidade de pares</label>
				<%= number_field_tag :memory_ai_pair_count, 4, min: 2, max: 20, data: { exercise_form_target: "memoryAiPairCount" } %>
				<label for="memory_ai_refinement">Instruções adicionais (opcional)</label>
				<%= text_field_tag :memory_ai_refinement, nil, maxlength: 300, data: { exercise_form_target: "memoryAiRefinement" } %>
				<button type="button" class="button" data-exercise-form-target="memoryAiGenerateButton" data-action="exercise-form#generateMemoryGame">Gerar sugestão</button>
				<button type="button" class="button" data-exercise-form-target="memoryAiRefineButton" data-action="exercise-form#refineAiSuggestion" data-exercise-form-kind-param="memoryGame" hidden>Refinar sugestão</button>
				<p data-exercise-form-target="memoryAiStatus" role="status" aria-live="polite"></p>
				<section class="quiz-ai-preview" data-exercise-form-target="memoryAiPreview" hidden aria-live="polite">
					<h3>Prévia dos pares</h3>
					<ol data-exercise-form-target="memoryAiPairs"></ol>
					<button type="button" class="button" data-exercise-form-target="memoryAiApplyButton" data-action="exercise-form#applyGeneratedMemoryGame" hidden>Aplicar ao editor</button>
				</section>
				<div class="actions"><button type="button" class="button" data-action="exercise-form#closeAiModal">Cancelar</button></div>
			</dialog>
			<p data-exercise-form-target="memoryAiImageNotice" hidden>Adicione uma imagem manualmente em cada campo visual antes de salvar.</p>
			<%= label_tag :memory_game_instructions, "Instruções" %>
			<%= text_area_tag :memory_game_instructions, nil, data: { exercise_form_target: "memoryInstructions" } %>

			<%= label_tag :memory_game_pair_type, "Tipo de associação" %>
			<%= select_tag :memory_game_pair_type,
				options_for_select([["Palavra ↔ Palavra", "word_word"], ["Palavra ↔ Imagem", "word_image"], ["Imagem ↔ Imagem", "image_image"]]),
				data: { exercise_form_target: "memoryPairType", action: "change->exercise-form#changeMemoryPairType" } %>

			<div data-exercise-form-target="memoryPairsList"></div>
			<template data-exercise-form-target="memoryPairTemplate">
				<fieldset class="memory-pair" data-memory-pair>
					<legend>Par <span data-memory-pair-number></span></legend>
					<div data-memory-side="left">
						<label data-memory-word-field>Elemento da esquerda<input type="text" data-memory-word></label>
						<label data-memory-image-field hidden>Imagem da esquerda
							<input type="file" accept="image/png,image/jpeg,image/webp" data-memory-image>
							<span data-memory-image-hint hidden></span>
							<img data-memory-image-preview alt="Prévia da imagem" hidden>
							<span data-memory-image-current hidden>Imagem atual</span>
						</label>
					</div>
					<div data-memory-side="right">
						<label data-memory-word-field>Elemento da direita<input type="text" data-memory-word></label>
						<label data-memory-image-field hidden>Imagem da direita
							<input type="file" accept="image/png,image/jpeg,image/webp" data-memory-image>
							<span data-memory-image-hint hidden></span>
							<img data-memory-image-preview alt="Prévia da imagem" hidden>
							<span data-memory-image-current hidden>Imagem atual</span>
						</label>
					</div>
					<button type="button" class="button danger" data-action="exercise-form#removeMemoryPair">Remover par</button>
				</fieldset>
			</template>
			<button type="button" class="button" data-action="exercise-form#addMemoryPair">Adicionar par</button>
			<p class="errors" data-exercise-form-target="memoryGameError" role="alert" hidden></p>
			<div class="actions">
				<button type="button" class="button" data-exercise-form-target="memoryPreviewButton" data-action="exercise-form#previewMemoryGame">Pré-visualizar jogo</button>
				<button type="button" class="button" data-exercise-form-target="memoryEditButton" data-action="exercise-form#editMemoryGame" hidden>Voltar à edição</button>
			</div>
		</div>
		<section data-exercise-form-target="memoryPreview" hidden aria-live="polite"></section>
	</fieldset>

	<div data-exercise-form-target="rawFields" hidden>
		<%= label_tag :exercise_object_json, "Conteúdo JSON" %>
		<%= text_area_tag :exercise_object_json, JSON.pretty_generate(exercise.object || {}), rows: 12, data: { exercise_form_target: "rawObject" } %>
	</div>

	<div class="actions">
		<%= form.submit "Salvar", data: { exercise_form_target: "submitButton" } %>
		<%= link_to "Cancelar", (@source_activity ? activity_path(@source_activity) : exercises_path), class: "button" %>
	</div>
<% end %>
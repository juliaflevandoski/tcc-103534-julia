<%= render "shared/errors", record: exercise %><%= form_with model: exercise do |form| %><%= form.label :teacher_id, "Professor" %><%= form.collection_select :teacher_id, teachers, :id, :name, include_blank: true %><%= form.label :title, "Título" %><%= form.text_field :title %><%= form.label :description, "Descrição" %><%= form.text_area :description %><%= form.label :exercise_type, "Tipo" %><%= form.select :exercise_type, Exercise.exercise_types.keys.map { |type| [type.humanize, type] }, include_blank: true %><%= form.label :object, "Conteúdo JSON" %><%= form.text_area :object, value: exercise.object.to_json, rows: 12 %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", exercises_path, class: "button" %></div><% end %>
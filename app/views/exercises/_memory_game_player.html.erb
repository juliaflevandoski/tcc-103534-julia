<div class="memory-player-page">
<header class="memory-player-header">
	<p class="memory-player-type">Jogo da memória</p>
	<h1 class="memory-player-title"><%= exercise.title %></h1>
	<p class="memory-player-instructions"><%= exercise.object.fetch("instructions") %></p>
</header>

<% if attempt.nil? || attempt.answer.to_h["completed"] %>
	<% if attempt %>
		<% answer = attempt.answer.to_h %>
		<% total_pairs = attempt.correct.fetch("deck").map { |card| card.fetch("pair_id") }.uniq.length %>
		<section class="memory-result" aria-live="polite">
			<h2>Jogo concluído</h2>
			<p>Pares encontrados: <strong><%= answer.fetch("matches", 0) %></strong> de <%= total_pairs %></p>
			<p>Tentativas: <strong><%= answer.fetch("attempts", 0) %></strong></p>
			<p>Acertos: <strong><%= answer.fetch("matches", 0) %></strong></p>
			<p>Erros: <strong><%= answer.fetch("errors", 0) %></strong></p>
			<p>Pontuação: <strong><%= attempt.score %></strong></p>
			<p>XP concedido nesta partida: <%= attempt.correct["xp_award_claimed"] ? attempt.score : 0 %></p>
			<p>Tempo: <strong><%= attempt.time_spent || 0 %></strong> segundos</p>
			<div class="memory-result-actions">
				<%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %>
				<%= link_to "Próximo exercício", exercise_path(next_activity_exercise.exercise, activity_exercise_id: next_activity_exercise.id), class: "button" if local_assigns[:next_activity_exercise] %>
				<%= form_with url: exercise_attempts_path, scope: :exercise_attempt do %>
					<%= hidden_field_tag "exercise_attempt[activity_exercise_id]", activity_exercise.id %>
					<%= submit_tag "Jogar novamente", class: "button" %>
				<% end %>
			</div>
		</section>
	<% end %>
	<% if attempt.nil? %>
	<%= form_with url: exercise_attempts_path, scope: :exercise_attempt do %>
		<%= hidden_field_tag "exercise_attempt[activity_exercise_id]", activity_exercise.id %>
		<%= submit_tag "Começar jogo", class: "button" %>
		<%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %>
	<% end %>
	<% end %>
<% else %>
	<div class="memory-game" data-controller="memory-game" data-memory-game-turn-url-value="<%= memory_game_turn_exercise_attempt_path(attempt) %>">
		<div class="memory-stats" aria-live="polite">
			<p><span class="memory-stat-label">Pares</span> <span class="memory-stat-value"><strong data-memory-game-target="matches"><%= game.fetch(:matches) %></strong> / <%= attempt.correct.fetch("deck").map { |card| card.fetch("pair_id") }.uniq.length %></span></p>
			<p><span class="memory-stat-label">Tentativas</span> <span class="memory-stat-value"><strong data-memory-game-target="attempts"><%= game.fetch(:attempts) %></strong></span></p>
			<p><span class="memory-stat-label">Erros</span> <span class="memory-stat-value"><strong data-memory-game-target="errors"><%= game.fetch(:errors) %></strong></span></p>
			<p><span class="memory-stat-label">Pontuação</span> <span class="memory-stat-value"><strong data-memory-game-target="score"><%= game.fetch(:score) %></strong></span></p>
		</div>
		<p class="memory-game-back-link"><%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %></p>
		<p data-memory-game-target="status" role="status"></p>
		<div class="memory-board" data-memory-game-target="board" aria-label="Tabuleiro do jogo da memória">
			<% revealed_cards = game.fetch(:revealed_cards).index_by { |card| card.fetch("id") } %>
			<% game.fetch(:card_ids).each do |card_id| %>
				<% card = revealed_cards[card_id] %>
				<% found = game.fetch(:matched_card_ids).include?(card_id) %>
				<button type="button" class="memory-card <%= "is-found" if found %> <%= "is-revealed" if card %>"
					aria-label="<%= card ? (found ? "Par encontrado" : "Carta revelada") : "Carta virada para baixo" %>"
					<%= "disabled" if found %>
					data-action="memory-game#selectCard"
					data-memory-game-target="card"
					data-card-id="<%= card_id %>"
					data-revealed="<%= card.present? %>"
					data-found="<%= found %>"
					data-selected="<%= game.fetch(:selected_card_id) == card_id %>"
					data-pending-reset="<%= game.fetch(:pending_reset_ids).include?(card_id) %>">
					<% if card %>
						<% if card.fetch("type") == "word" %>
							<%= card.fetch("content") %>
						<% else %>
							<%= image_tag card.fetch("url"), alt: "Imagem da carta" %>
						<% end %>
					<% else %>
						<span aria-hidden="true">?</span>
					<% end %>
				</button>
			<% end %>
		</div>
		<section class="memory-result" data-memory-game-target="completion" hidden aria-live="polite">
			<h2>Jogo concluído</h2>
			<p>Pares encontrados: <strong data-memory-game-target="finalMatches"></strong></p>
			<p>Acertos: <strong data-memory-game-target="finalHits"></strong></p>
			<p>Tentativas: <strong data-memory-game-target="finalAttempts"></strong></p>
			<p>Erros: <strong data-memory-game-target="finalErrors"></strong></p>
			<p>Pontuação: <strong data-memory-game-target="finalScore"></strong></p>
			<p>XP concedido nesta partida: <strong data-memory-game-target="finalXp"></strong></p>
			<p>Tempo: <strong data-memory-game-target="finalTime"></strong> segundos</p>
			<div class="memory-result-actions">
				<%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %>
				<%= link_to "Próximo exercício", exercise_path(next_activity_exercise.exercise, activity_exercise_id: next_activity_exercise.id), class: "button" if local_assigns[:next_activity_exercise] %>
				<%= form_with url: exercise_attempts_path, scope: :exercise_attempt do %>
					<%= hidden_field_tag "exercise_attempt[activity_exercise_id]", activity_exercise.id %>
					<%= submit_tag "Jogar novamente", class: "button" %>
				<% end %>
			</div>
		</section>
	</div>
<% end %>
</div>
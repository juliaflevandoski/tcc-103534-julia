	<% prefilled_answers = local_assigns[:answers] || {} %>
	<h1><%= exercise.title %></h1>
	<p>Quiz</p>
	<p><%= link_to "Voltar à aula", activity_path(activity_exercise.activity), class: "button" if activity_exercise&.persisted? %></p>
	<%= form_with url: exercise_attempts_path, scope: :exercise_attempt,
		data: { controller: "required-responses", action: "input->required-responses#update change->required-responses#update submit->required-responses#validate" } do %>
		<%= hidden_field_tag "exercise_attempt[activity_exercise_id]", activity_exercise.id %>
		<ol class="quiz-questions">
			<% exercise.object.fetch("questions").each_with_index do |question, question_index| %>
				<li>
					<fieldset>
						<legend><%= question.fetch("statement") %></legend>
						<% case question.fetch("question_type") %>
						<% when "multiple_choice" %>
							<% question.fetch("options").each_with_index do |option, option_index| %>
								<% option_id = "quiz-question-#{question_index}-option-#{option_index}" %>
								<div class="quiz-answer-option">
									<%= radio_button_tag "exercise_attempt[answers][#{question_index}]", option.fetch("id"), prefilled_answers[question_index.to_s] == option.fetch("id"), id: option_id, required: true,
										data: { required_responses_target: "field", response_group: "question-#{question_index}", response_label: "questão #{question_index + 1}" } %>
									<%= label_tag option_id, option.fetch("text") %>
								</div>
							<% end %>
						<% when "true_false" %>
							<% [["true", "Verdadeiro"], ["false", "Falso"]].each do |value, label| %>
								<% option_id = "quiz-question-#{question_index}-#{value}" %>
								<div class="quiz-answer-option">
									<%= radio_button_tag "exercise_attempt[answers][#{question_index}]", value, prefilled_answers[question_index.to_s] == value, id: option_id, required: true,
										data: { required_responses_target: "field", response_group: "question-#{question_index}", response_label: "questão #{question_index + 1}" } %>
									<%= label_tag option_id, label %>
								</div>
							<% end %>
						<% when "short_answer" %>
							<%= text_field_tag "exercise_attempt[answers][#{question_index}]", prefilled_answers[question_index.to_s],
								id: "quiz-question-#{question_index}-answer", autocomplete: "off", required: true,
								data: { required_responses_target: "field", response_group: "question-#{question_index}", response_label: "questão #{question_index + 1}" } %>
						<% end %>
					</fieldset>
				</li>
			<% end %>
		</ol>
		<p data-required-responses-target="status" role="status" aria-live="polite"></p>
		<%= submit_tag "Enviar respostas", class: "button", data: { turbo_submits_with: "Enviando..." } %>
	<% end %>

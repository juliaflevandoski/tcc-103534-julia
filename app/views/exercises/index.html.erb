<main><div class="toolbar"><h1>Exercícios</h1><%= link_to "Novo exercício", new_exercise_path, class: "button" %></div><table><thead><tr><th>Título</th><th>Tipo</th><th>Professor</th><th></th></tr></thead><tbody><% @exercises.each do |exercise| %><tr><td><%= exercise.title %></td><td><%= exercise.exercise_type %></td><td><%= exercise.teacher.name %></td><td><%= link_to "Ver", exercise %> | <%= link_to "Editar", edit_exercise_path(exercise) %> | <%= button_to "Desativar", exercise, method: :delete, class: "button danger" %></td></tr><% end %></tbody></table></main>
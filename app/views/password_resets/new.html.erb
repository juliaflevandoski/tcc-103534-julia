<main class="auth-form-page">
  <div class="auth-form-shell">
    <header class="auth-form-header">
      <span class="auth-form-badge">Conta</span>
      <h1>Recuperar senha</h1>
    </header>
    <%= form_with url: new_password_reset_path, method: :post, class: "auth-form-card" do |form| %>
      <%= hidden_field_tag :role, @role %>
      <div class="auth-form-field">
        <%= form.label :email, "E-mail" %>
        <%= form.email_field :email, required: true, autocomplete: "email" %>
      </div>
      <div class="actions auth-form-actions">
        <%= form.submit "Solicitar recuperação", class: "button auth-form-submit" %>
        <%= link_to "Voltar", login_path(role: @role), class: "auth-form-back" %>
      </div>
    <% end %>
  </div>
</main>
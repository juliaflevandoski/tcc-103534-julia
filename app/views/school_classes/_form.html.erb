<%= render "shared/errors", record: school_class %><%= form_with model: school_class do |form| %><%= form.label :name, "Nome" %><%= form.text_field :name, required: true, maxlength: 50 %><%= form.label :description, "Descrição" %><%= form.text_area :description, maxlength: 255 %><%= form.label :xp_points, "XP da turma" %><%= form.number_field :xp_points, min: 0 %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", school_classes_path, class: "button" %></div><% end %>
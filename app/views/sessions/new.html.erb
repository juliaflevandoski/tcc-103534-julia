<main>
  <h1>Entrar no Ludus</h1>
  <% if @role %>
    <h2><%= @role == "teacher" ? "Professor" : "Aluno" %></h2>
    <%= form_with url: login_path, method: :post do |form| %>
      <%= hidden_field_tag :role, @role %>
      <%= form.label :username, "Usuário" %>
      <%= form.text_field :username, required: true, autofocus: true %>
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, required: true %>
      <div class="actions"><%= form.submit "Entrar", class: "button" %></div>
    <% end %>
    <p><%= link_to "Criar cadastro", register_path(@role) %> | <%= link_to "Esqueci minha senha", new_password_reset_path(role: @role) %></p>
    <p><%= link_to "Escolher outro perfil", login_path %></p>
  <% else %>
    <p>Escolha como deseja acessar.</p>
    <div class="actions">
      <%= link_to "Entrar como professor", login_path(role: "teacher"), class: "button" %>
      <%= link_to "Entrar como aluno", login_path(role: "student"), class: "button" %>
    </div>
  <% end %>
</main>
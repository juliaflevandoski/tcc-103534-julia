<% if record.errors.any? %>
  <div class="errors">
    <h2><%= record.errors.count == 1 ? "1 erro impediu o salvamento:" : "#{record.errors.count} erros impediram o salvamento:" %></h2>
    <ul><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
<%= render "shared/errors", record: student_stat %><%= form_with model: student_stat do |form| %><%= form.label :student_id, "Aluno" %><%= form.collection_select :student_id, students, :id, :name, include_blank: true %><%= form.label :xp, "XP" %><%= form.number_field :xp, min: 0 %><%= form.label :level, "Nível" %><%= form.number_field :level, min: 1 %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", student_stats_path, class: "button" %></div><% end %>
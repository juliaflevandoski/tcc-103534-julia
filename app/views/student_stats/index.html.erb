<main><div class="toolbar"><h1>Progresso dos alunos</h1><%= link_to "Novo registro", new_student_stat_path, class: "button" %></div><table><thead><tr><th>Aluno</th><th>XP</th><th>Nível</th><th></th></tr></thead><tbody><% @student_stats.each do |stat| %><tr><td><%= stat.student.name %></td><td><%= stat.xp %></td><td><%= stat.level %></td><td><%= link_to "Ver", stat %> | <%= link_to "Editar", edit_student_stat_path(stat) %> | <%= button_to "Remover", stat, method: :delete, class: "button danger" %></td></tr><% end %></tbody></table></main>
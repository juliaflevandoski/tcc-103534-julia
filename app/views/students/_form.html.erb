<%= render "shared/errors", record: student %><%= form_with model: student do |form| %><%= form.label :name, "Nome" %><%= form.text_field :name %><%= form.label :username, "Usuário" %><%= form.text_field :username %><%= form.label :email, "E-mail" %><%= form.email_field :email %><%= form.label :password, "Senha" %><%= form.password_field :password %><%= form.label :password_confirmation, "Confirmação da senha" %><%= form.password_field :password_confirmation %><div class="actions"><%= form.submit "Salvar" %><%= link_to "Cancelar", students_path, class: "button" %></div><% end %>
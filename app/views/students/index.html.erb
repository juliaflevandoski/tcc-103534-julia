<main><div class="toolbar"><h1>Alunos</h1><%= link_to "Novo aluno", new_student_path, class: "button" %></div><table><thead><tr><th>Nome</th><th>Usuário</th><th>E-mail</th><th></th></tr></thead><tbody><% @students.each do |student| %><tr><td><%= student.name %></td><td><%= student.username %></td><td><%= student.email %></td><td><%= link_to "Ver", student %> | <%= link_to "Editar", edit_student_path(student) %> | <%= button_to "Desativar", student, method: :delete, class: "button danger" %></td></tr><% end %></tbody></table></main>